{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://group27.local/schemas/flow_result.schema.json",
  "title": "FlowResult metadata envelope",
  "description": "Forward, previous-frame-indexed optical flow between available Stream Handler RGB8 FramePackets. The float32 HxWx2 field and boolean HxW mask travel separately from this metadata envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "source_id", "current_frame_id", "current_capture_timestamp_ns", "timestamp_origin", "width", "height", "direction", "units", "backend", "flow_width", "flow_height", "valid_fraction", "elapsed_ns"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["ok", "no_previous_frame", "invalid_timestamps", "scene_cut"]},
    "source_id": {"type": "string", "minLength": 1},
    "previous_frame_id": {"type": ["integer", "null"], "minimum": 0},
    "current_frame_id": {"type": "integer", "minimum": 0},
    "previous_capture_timestamp_ns": {"type": ["integer", "null"], "minimum": 0},
    "current_capture_timestamp_ns": {"type": "integer", "minimum": 0},
    "timestamp_origin": {"enum": ["source_presentation", "decode_monotonic"]},
    "elapsed_ns": {"type": ["integer", "null"], "minimum": 1},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "direction": {"const": "previous_to_current"},
    "units": {"const": "pixels_at_output_resolution"},
    "backend": {"enum": ["opencv_dis", "raft_small"]},
    "flow_width": {"type": "integer", "minimum": 1},
    "flow_height": {"type": "integer", "minimum": 1},
    "valid_fraction": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
